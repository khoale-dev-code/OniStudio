# Public site URL; use your real HTTPS domain before production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave both blank to run the read-only local catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudinary API secret and API key are server-only. Never prefix them NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional verified links. Zalo, Instagram and TikTok are hidden until configured.
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
